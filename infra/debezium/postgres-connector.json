{
  "name": "lms-postgres-cdc",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "database.hostname": "postgres",
    "database.port": "5432",
    "database.user": "lms",
    "database.password": "lms",
    "database.dbname": "lms",
    "plugin.name": "pgoutput",
    "slot.name": "edu_cdc_slot",
    "publication.name": "edu_cdc_pub",
    "publication.autocreate.mode": "filtered",
    "topic.prefix": "cdc.lms",
    "table.include.list": "public.organisations,public.learners,public.courses,public.lessons,public.course_content,public.assignments,public.test_cases,public.enrollments,public.lesson_progress,public.submissions,public.grades",
    "snapshot.mode": "initial",
    "tombstones.on.delete": "false",
    "decimal.handling.mode": "double",
    "time.precision.mode": "connect",
    "heartbeat.interval.ms": "10000",
    "transforms": "unwrap",
    "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
    "transforms.unwrap.drop.tombstones": "true",
    "transforms.unwrap.delete.handling.mode": "rewrite",
    "transforms.unwrap.add.fields": "op,ts_ms,source.lsn,source.txId"
  }
}

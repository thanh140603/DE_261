# Copy to .env and adjust. Never commit .env.
EDU_ENV=local

# Messaging
EDU_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
EDU_SCHEMA_REGISTRY_URL=http://localhost:8081

# OLTP (CDC source) - used only by Debezium / local seeding, never by analytics jobs
EDU_POSTGRES_DSN=postgresql://lms:lms@localhost:5432/lms

# Low-latency serving layer (online feature store, risk scores, notification state)
EDU_REDIS_URL=redis://localhost:6379/0

# Lakehouse (Delta Lake on object storage). Local dev uses SeaweedFS (ADR 0011); the keys
# must match infra/seaweedfs/s3.json.
EDU_LAKEHOUSE_ROOT=s3a://lakehouse
EDU_S3_ENDPOINT=http://localhost:9000
EDU_S3_ACCESS_KEY=lakehouse
EDU_S3_SECRET_KEY=lakehouse-secret-key

# Warehouse (ADR 0009): Spark master, shared catalog, SQL files
EDU_SPARK_MASTER=local[*]
EDU_HIVE_METASTORE_URI=thrift://localhost:9083
EDU_WAREHOUSE_DIR=warehouse

# Host port overrides when 5432 / 8000 are taken by other projects
# POSTGRES_PORT=55432
# DEMO_PORT=8001

# Unstructured corpus bucket
EDU_CORPUS_BUCKET=corpus

# PII pseudonymisation secret (HMAC key). Rotate via secret manager in non-local envs.
EDU_PII_HMAC_SECRET=change-me

# Search / vector index
EDU_SEARCH_URL=http://localhost:9200
EDU_EMBEDDING_ENDPOINT=http://localhost:8000/embed

# Notification channels
EDU_PUSH_PROVIDER_KEY=
EDU_EMAIL_SMTP_URL=
